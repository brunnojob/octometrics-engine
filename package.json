{
  "name": "octometrics-engine",
  "version": "1.0.0",
  "description": "GitHub contribution metrics and verified pull request webhooks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:metrics": "node dist/index.js metrics",
    "start:webhooks": "node dist/index.js webhooks",
    "dev:metrics": "node --loader ts-node/esm src/index.ts metrics",
    "dev:webhooks": "node --loader ts-node/esm src/index.ts webhooks"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
